# ── Web app (Vercel) ──────────────────────────────────────
# URL of the deployed Edge API — used server-side by Next.js proxy routes for auth.
# Must NOT have a trailing slash.
EDGE_API_URL=
# URL of the deployed Edge API — used client-side for authenticated API calls (agents, receipts, etc.).
# Set to the same host as EDGE_API_URL. Required for non-auth app pages to load real data.
NEXT_PUBLIC_API_URL=

# ── Shared secrets ────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
RECEIPT_RELAYER=
ZERO_G_GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_ARISTOTLE_RPC_URL=https://evmrpc.0g.ai
ZERO_G_GALILEO_CHAIN_ID=16602
ZERO_G_ARISTOTLE_CHAIN_ID=16661
ZERO_G_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
POSTGRES_URL=
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
EDGE_JWT_SECRET=
EDGE_SERVICE_PRIVATE_KEY=
# Wallet identity for on-chain receipt mints from Apogee Pilot chat.
# Without this, unauthenticated pilot chat works but its receipts are not minted
# on-chain (you will see `pilot.chat.mint.skipped` in edge logs).
PILOT_AGENT_PRIVATE_KEY=
PAYMENT_ROUTER_ADDRESS=
RECEIPT_BOOK_ADDRESS=
ACCOUNT_FACTORY_ADDRESS=
AGENT_IDENTITY_ADDRESS=
TAVILY_API_KEY=
OPENAI_API_KEY=
CHAINSCAN_GALILEO_API_KEY=
