{
  "name": "@apogee/billing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./receipt-minter": { "types": "./dist/receipt-minter.d.ts", "import": "./dist/receipt-minter.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "dependencies": {
    "@apogee/chain-client": "workspace:*",
    "@apogee/storage-client": "workspace:*",
    "bullmq": "5.65.0",
    "ethers": "6.13.1",
    "ioredis": "5.8.2",
    "pino": "10.3.1",
    "zod": "4.4.3"
  }
